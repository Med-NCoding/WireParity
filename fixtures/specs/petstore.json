{
  "openapi": "3.0.3",
  "info": {
    "title": "WireParity PetStore",
    "description": "Canonical reference PetStore spec used by WireParity for SDK generation and parity testing. Covers a representative slice of OpenAPI 3.0.3 features: path/query/header parameters, request bodies, $ref schemas, allOf composition, enums, arrays, nullable fields, and API key auth.",
    "version": "1.0.0",
    "contact": {
      "name": "WireParity",
      "url": "https://github.com/Med-NCoding/WireParity"
    }
  },
  "servers": [
    { "url": "http://localhost:9000", "description": "WireParity local capture server" }
  ],
  "security": [
    { "ApiKeyAuth": [] }
  ],
  "tags": [
    { "name": "pets", "description": "Operations on pets" },
    { "name": "store", "description": "Store and order operations" }
  ],
  "paths": {
    "/pets": {
      "get": {
        "operationId": "listPets",
        "summary": "List all pets",
        "tags": ["pets"],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of pets to return",
            "required": false,
            "schema": { "type": "integer", "format": "int32", "minimum": 1, "maximum": 100 }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Filter pets by status",
            "required": false,
            "explode": false,
            "schema": {
              "type": "array",
              "items": { "$ref": "#/components/schemas/PetStatus" }
            }
          },
          {
            "name": "tags",
            "in": "query",
            "description": "Filter pets by tags",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          {
            "$ref": "#/components/parameters/AcceptLanguage"
          }
        ],
        "responses": {
          "200": {
            "description": "A list of pets",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Pet" }
                }
              }
            }
          },
          "default": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createPet",
        "summary": "Create a pet",
        "tags": ["pets"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/NewPet" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Pet created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Pet" }
              }
            }
          },
          "default": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/pets/{petId}": {
      "parameters": [
        {
          "name": "petId",
          "in": "path",
          "required": true,
          "description": "The unique identifier of the pet",
          "schema": { "type": "string", "format": "uuid" }
        }
      ],
      "get": {
        "operationId": "getPetById",
        "summary": "Get a pet by ID",
        "tags": ["pets"],
        "parameters": [
          {
            "name": "include",
            "in": "query",
            "description": "Related resources to include",
            "required": false,
            "style": "pipeDelimited",
            "explode": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["vaccinations", "owner", "appointments"]
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The pet",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Pet" }
              }
            }
          },
          "404": {
            "description": "Pet not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "updatePet",
        "summary": "Update an existing pet",
        "tags": ["pets"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PetUpdate" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Pet updated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Pet" }
              }
            }
          },
          "404": {
            "description": "Pet not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deletePet",
        "summary": "Delete a pet",
        "tags": ["pets"],
        "responses": {
          "204": { "description": "Pet deleted" },
          "404": {
            "description": "Pet not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/store/orders": {
      "post": {
        "operationId": "placeOrder",
        "summary": "Place an order for a pet",
        "tags": ["store"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/NewOrder" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Order placed",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Order" }
              }
            }
          },
          "default": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/store/orders/{orderId}": {
      "parameters": [
        {
          "name": "orderId",
          "in": "path",
          "required": true,
          "description": "The unique identifier of the order",
          "schema": { "type": "integer", "format": "int64", "minimum": 1 }
        }
      ],
      "get": {
        "operationId": "getOrderById",
        "summary": "Get an order by ID",
        "tags": ["store"],
        "parameters": [
          {
            "name": "X-Request-ID",
            "in": "header",
            "required": false,
            "description": "Idempotency key for the request",
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "The order",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Order" }
              }
            }
          },
          "404": {
            "description": "Order not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteOrder",
        "summary": "Delete an order",
        "tags": ["store"],
        "responses": {
          "204": { "description": "Order deleted" },
          "404": {
            "description": "Order not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    },
    "parameters": {
      "AcceptLanguage": {
        "name": "Accept-Language",
        "in": "header",
        "required": false,
        "description": "Preferred response language (BCP-47 tag)",
        "schema": { "type": "string" }
      }
    },
    "schemas": {
      "PetStatus": {
        "type": "string",
        "enum": ["available", "pending", "sold"],
        "description": "The status of a pet in the store"
      },
      "PetCategory": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "Category ID"
          },
          "name": {
            "type": "string",
            "description": "Category name",
            "minLength": 1,
            "maxLength": 64
          }
        }
      },
      "BasePet": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": {
            "type": "string",
            "description": "The name of the pet",
            "minLength": 1,
            "maxLength": 128
          },
          "status": {
            "$ref": "#/components/schemas/PetStatus"
          },
          "category": {
            "$ref": "#/components/schemas/PetCategory"
          },
          "tags": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true,
            "description": "Free-form tags on the pet"
          },
          "notes": {
            "type": "string",
            "nullable": true,
            "description": "Optional free-text notes about the pet"
          }
        }
      },
      "NewPet": {
        "allOf": [
          { "$ref": "#/components/schemas/BasePet" }
        ],
        "description": "Payload for creating a new pet"
      },
      "PetUpdate": {
        "type": "object",
        "description": "Payload for updating an existing pet — all fields optional",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "status": {
            "$ref": "#/components/schemas/PetStatus"
          },
          "notes": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "Pet": {
        "allOf": [
          { "$ref": "#/components/schemas/BasePet" }
        ],
        "required": ["id", "createdAt"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Unique pet identifier"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "ISO-8601 timestamp of pet creation"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "ISO-8601 timestamp of last update"
          }
        },
        "description": "A pet returned from the API"
      },
      "OrderStatus": {
        "type": "string",
        "enum": ["placed", "approved", "delivered", "cancelled"],
        "description": "The status of an order"
      },
      "NewOrder": {
        "type": "object",
        "required": ["petId", "quantity"],
        "description": "Payload for placing an order",
        "properties": {
          "petId": {
            "type": "string",
            "format": "uuid",
            "description": "ID of the pet being ordered"
          },
          "quantity": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 10,
            "description": "Number of pets to order"
          },
          "shipDate": {
            "type": "string",
            "format": "date",
            "nullable": true,
            "description": "Requested ship date (YYYY-MM-DD)"
          },
          "notes": {
            "type": "string",
            "nullable": true,
            "description": "Optional order notes"
          }
        }
      },
      "Order": {
        "type": "object",
        "required": ["id", "petId", "quantity", "status", "placedAt"],
        "description": "An order returned from the API",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "Unique order identifier"
          },
          "petId": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "status": {
            "$ref": "#/components/schemas/OrderStatus"
          },
          "shipDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "notes": {
            "type": "string",
            "nullable": true
          },
          "placedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": ["code", "message"],
        "description": "Standard error response",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32",
            "description": "HTTP status code"
          },
          "message": {
            "type": "string",
            "description": "Human-readable error description"
          },
          "details": {
            "type": "string",
            "nullable": true,
            "description": "Optional additional details"
          }
        }
      }
    }
  }
}
