  },
  "keywords": [
    "differential-testing",
    "openapi",
    "sdk",
    "wireparity"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "fast-check": "^4.9.0"
  }
}
