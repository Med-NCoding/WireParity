{
  "name": "wireparity",
  "version": "0.1.0",
  "description": "Differential testing tool for multi-language API SDKs",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "wireparity": "./dist/cli/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {


    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate:sdks": "bash scripts/generate_sdks.sh",
    "wireparity": "node ./dist/cli/bin.js",
    "prepare": "pnpm build",
    "prepublishOnly": "pnpm build && pnpm typecheck && pnpm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Med-NCoding/WireParity.git"
  },
  "engines": {
    "node": ">=18.3.0"
  },
  "keywords": [
    "differential-testing",
    "openapi",
    "sdk",
    "wireparity"
  ],
  "author": "Medhansh <medhanshnegi4@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "fast-check": "^4.9.0",
    "yaml": "^2.9.0"
  }
}

