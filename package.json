{
  "name": "wireparity",
  "version": "0.1.0",
  "description": "Differential testing tool for multi-language API SDKs",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "wireparity": "./dist/cli/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {


